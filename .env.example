# ==============================================================================
# ECU Men's Ice Hockey Calendar Environment Configuration
# ==============================================================================

# Database Persistence
# SQLite local volume example: sqlite:////data/ecu_hockey.db
# PostgreSQL managed example: postgresql://<user>:<password>@localhost:5432/<database>
DATABASE_URL=postgresql://ecu_hockey_user:ecu_hockey_password@localhost:5432/ecu_hockey  # pragma: allowlist secret

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=ecu_hockey_user
POSTGRES_PASSWORD=ecu_hockey_password
POSTGRES_DB=ecu_hockey

# Container Image (used by docker-compose; defaults to ghcr.io/bdperkin/ecu-hockey-calendar:latest)
# DOCKER_IMAGE=ghcr.io/bdperkin/ecu-hockey-calendar:latest

# Server Settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# Auto-run Alembic schema migrations on server startup (true/false)
AUTO_MIGRATE=true

# API Security
# Token required for administrative endpoints (POST /api/v1/sync/trigger, GET /api/v1/conflicts)
ADMIN_API_TOKEN=change-this-to-a-secure-random-token-in-production

# Webhook Alert Channels (Optional)
# Leave blank to disable specific notification dispatchers
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Proxy Configuration (Optional - for Instagram / anti-bot scraping mitigation)
# Example: http://<username>:<password>@proxy.example.com:8080
PROXY_URL=
